# AI Agent - Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Model API (required for knowledge-base Q&A)
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-api-key-here
DEFAULT_MODEL=deepseek-chat
PRO_MODEL=deepseek-reasoner
FAST_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Platform security
# ---------------------------------------------------------------------------
AGENT_API_KEY=dev-key-change-in-production
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ALLOW_CLIENT_MODEL_KEY=false
RATE_LIMIT=60
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# Docker Compose persistence (MySQL)
# ---------------------------------------------------------------------------
MYSQL_DATABASE=ai_agent
MYSQL_USER=ai_agent
MYSQL_PASSWORD=ai_agent_demo_password
MYSQL_ROOT_PASSWORD=root_demo_password

# ---------------------------------------------------------------------------
# Storage backends
# ---------------------------------------------------------------------------
# Out-of-the-box demo uses Redis memory and in-process vectors.
VECTOR_STORE_TYPE=memory
MEMORY_TYPE=redis
REDIS_HEALTH=true
# Some WSL/VPN environments black-hole TLS traffic on a 1500-byte Docker MTU.
DOCKER_NETWORK_MTU=1400

# Switch to Qdrant only when an OpenAI-compatible embedding provider is ready.
# Also set AUTOCONFIG_EXCLUDE= (empty) and QDRANT_INIT_SCHEMA=true.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_chunks
QDRANT_INIT_SCHEMA=false
AUTOCONFIG_EXCLUDE=org.springframework.ai.vectorstore.qdrant.autoconfigure.QdrantVectorStoreAutoConfiguration

# Embeddings only apply to VECTOR_STORE_TYPE=qdrant.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Local development overrides
# ---------------------------------------------------------------------------
SERVER_PORT=8080
H2_CONSOLE=false
H2_USERNAME=sa
H2_PASSWORD=
FILE_ACCESS_DIR=./workspace
LEGACY_RAG_ENABLED=false
