# AI Agent - Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Model API (required for knowledge-base Q&A)
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-api-key-here
DEFAULT_MODEL=deepseek-chat
PRO_MODEL=deepseek-reasoner
FAST_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Platform security
# ---------------------------------------------------------------------------
AGENT_API_KEY=dev-key-change-in-production
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ALLOW_CLIENT_MODEL_KEY=false
RATE_LIMIT=60
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# Docker Compose persistence (MySQL)
# ---------------------------------------------------------------------------
MYSQL_DATABASE=ai_agent
MYSQL_USER=ai_agent
MYSQL_PASSWORD=ai_agent_demo_password
MYSQL_ROOT_PASSWORD=root_demo_password

# ---------------------------------------------------------------------------
# Storage backends
# ---------------------------------------------------------------------------
# Out-of-the-box demo uses Redis memory and in-process vectors.
VECTOR_STORE_TYPE=memory
MEMORY_TYPE=redis
REDIS_HEALTH=true
# Some WSL/VPN environments black-hole TLS traffic on a 1500-byte Docker MTU.
DOCKER_NETWORK_MTU=1400

# Switch to Qdrant only when an OpenAI-compatible embedding provider is ready.
# Also set AUTOCONFIG_EXCLUDE= (empty) and QDRANT_INIT_SCHEMA=true.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_chunks
QDRANT_INIT_SCHEMA=false
AUTOCONFIG_EXCLUDE=org.springframework.ai.vectorstore.qdrant.autoconfigure.QdrantVectorStoreAutoConfiguration

# Embeddings only apply to VECTOR_STORE_TYPE=qdrant.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Local development overrides
# ---------------------------------------------------------------------------
SERVER_PORT=8080
H2_CONSOLE=false
H2_USERNAME=sa
H2_PASSWORD=
FILE_ACCESS_DIR=./workspace
LEGACY_RAG_ENABLED=false

# ---------------------------------------------------------------------------
# 管理接口权限（/api/admin/** 需要 ADMIN 角色）
# ---------------------------------------------------------------------------
# 方式一：名单里的用户名注册后即为 admin（逗号分隔；默认空）
ADMIN_USERNAMES=
# 方式二：启动时创建/复用引导管理员（已存在同名用户不会自动提权）
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# AI 网关（L1 计量 / L2 稳定性 / L3 缓存 / L4 指标）
# ---------------------------------------------------------------------------
# 总开关：false 时网关内部直接调用模型，不做计量/缓存/限流
GATEWAY_ENABLED=true
# L1：用量计量（关闭后不写 llm_usage_record，主链路行为不变）
GATEWAY_METERING_ENABLED=true
# L2：按模型限流/熔断/重试（默认关闭，先让计量跑对再开）
GATEWAY_RESILIENCE_ENABLED=false
# L4：Micrometer 指标（/actuator/prometheus）
GATEWAY_METRICS_ENABLED=true
# L3：Prompt 模板入库 + 版本管理（关闭后回退到代码内置模板）
GATEWAY_PROMPT_STORE_ENABLED=true
# 网关层超时（必须小于 AiConfig 的 60s）
GATEWAY_TIMEOUT_SECONDS=30
GATEWAY_RATE_LIMIT_PER_MODEL_PER_SECOND=5
GATEWAY_RETRY_MAX_ATTEMPTS=2
# 语义缓存：只有 VECTOR_STORE_TYPE=qdrant 且配好 EMBEDDING_API_KEY 时才真正生效
GATEWAY_CACHE_ENABLED=true
GATEWAY_CACHE_THRESHOLD=0.92
GATEWAY_CACHE_TTL_HOURS=24
# 单价（微元 / 百万 token，即 元/百万token × 1000000）；务必按实际账单核对
PRICE_DEEPSEEK_CHAT_PROMPT=2000000
PRICE_DEEPSEEK_CHAT_COMPLETION=8000000
