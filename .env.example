# AI Agent - Environment Variables Template
# Copy this file to .env and fill in your values
# .env file is git-ignored and will NOT be uploaded to GitHub

# DeepSeek API Key (required)
# Get yours at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-api-key-here

# Model Configuration (optional, defaults shown)
DEFAULT_MODEL=deepseek-v4-flash
PRO_MODEL=deepseek-v4-pro
FAST_MODEL=deepseek-v4-flash
VISION_MODEL=deepseek-v4-flash-vision-exp

# Phase 3: Storage Backend (optional, defaults shown)
# Vector Store: memory (dev, no Docker) | qdrant (prod, needs Docker)
VECTOR_STORE_TYPE=memory
# Chat Memory: memory (dev, no Docker) | redis (prod, needs Docker)
MEMORY_TYPE=memory

# Qdrant Configuration (only needed when VECTOR_STORE_TYPE=qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai-agent-docs
QDRANT_INIT_SCHEMA=false

# Redis Configuration (only needed when MEMORY_TYPE=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_HEALTH=false

# P0 Security Configuration
# API Key for tool execution endpoints (X-API-Key header)
AGENT_API_KEY=dev-key-change-in-production
# File sandbox directory (file tool can only access files inside this dir)
FILE_ACCESS_DIR=./workspace
# H2 Console (default off, set true for local debugging)
H2_CONSOLE=false
H2_USERNAME=sa
H2_PASSWORD=
